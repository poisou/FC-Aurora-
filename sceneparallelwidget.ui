 <class>SceneParallelWidget</class>
 <widget class="QWidget" name="SceneParallelWidget">
  <property name="styleSheet">
   <string notr="true">QFrame#devicePanel, QFrame#configPanel {
    background: #FFFFFF;
    border: 1px solid #A6B8C8;
    border-radius: 4px;
}
QLabel#pageTitle {
    color: #253746;
    font-size: 16px;
    font-weight: 600;
}
QLabel#currentDeviceLabel {
    color: #253746;
    font-size: 14px;
    font-weight: 600;
    min-height: 32px;
    padding: 2px 0;
}
QTabWidget#messageTabWidget::pane {
    background: #FFFFFF;
    border: 1px solid #A6B8C8;
    border-radius: 3px;
}
QTabWidget#messageTabWidget QTabBar::tab {
    min-width: 86px;
    min-height: 30px;
    padding: 0 12px;
    background: #EEF3F6;
    color: #456071;
    border: 1px solid #A6B8C8;
    border-bottom: none;
}
QTabWidget#messageTabWidget QTabBar::tab:selected {
    background: #FFFFFF;
    color: #21465D;
    font-weight: 600;
}
QTabWidget#messageTabWidget QTabBar::tab:hover:!selected {
    background: #E1EEF2;
}
QGroupBox {
    color: #2F495A;
    font-weight: 600;
    border: 1px solid #C3D1DA;
    border-radius: 3px;
    margin-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}
QTableWidget {
    background: #FFFFFF;
    alternate-background-color: #F7FAFB;
    color: #344B58;
    border: 1px solid #C3D1DA;
    gridline-color: #E1E8EC;
    selection-background-color: #DCEFF3;
    selection-color: #244955;
}
QHeaderView::section {
    background: #EEF3F6;
    color: #365263;
    border: none;
    border-right: 1px solid #D4DFE5;
    border-bottom: 1px solid #AFC1CC;
    padding: 4px 6px;
    font-weight: 600;
}</string>
